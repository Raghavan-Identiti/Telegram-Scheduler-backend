# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# App Data
uploads/
logs/
data/
*.db
*.xlsx
*.session

# WhatsApp Auth (Crucial so you don't commit sessions)
whatsapp-service/.wwebjs_auth/
whatsapp-service/.wwebjs_cache/
.env*
.env


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
